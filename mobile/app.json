{
  "expo": {
    "name": "Korevyn",
    "slug": "korevyn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.korevyn.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#0d1117"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.korevyn.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "extra": {
      "apiBaseUrl": "",
      "eas": {
        "projectId": "eeaf8e8a-fd7d-4859-9953-d4add65b9b04"
      }
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Korevyn to access your photos to upload your company logo.",
          "cameraPermission": "Allow Korevyn to use your camera to take a photo of your company logo."
        }
      ]
    ]
  }
}